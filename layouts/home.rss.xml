{{- /* The site's one feed: the posts (not the about or search pages), newest first, each with
       its summary, the whole post, its writer and its tags. The channel describes the site in
       its own words. The post is rendered for the feed by the *.rss.xml hooks in _markup/:
       full addresses, no copy buttons or heading links, and diagrams as images. */ -}}
{{- $posts := where site.RegularPages "Section" "in" site.Params.mainSections }}
{{- $posts = first (site.Params.rssLimit | default 20) $posts.ByDate.Reverse }}
{{- $rfc822 := "Mon, 02 Jan 2006 15:04:05 -0700" }}
{{- printf "<?xml version=%q encoding=%q standalone=%q?>" "1.0" "utf-8" "yes" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default "en-US" }}</language>
    {{- with $posts }}
    <lastBuildDate>{{ (index . 0).Lastmod.Format $rfc822 | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=%q type=%q />" .Permalink "self" .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .PublishDate.Format $rfc822 | safeHTML }}</pubDate>
      <dc:creator>{{ site.Params.author }}</dc:creator>
      {{- range .GetTerms "tags" }}
      <category>{{ .LinkTitle | lower }}</category>
      {{- end }}
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ .Content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>

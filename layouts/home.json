{{- $index := slice -}}
{{- range where site.RegularPages "Section" "in" site.Params.mainSections -}}
{{- $index = $index | append (dict
  "title" .Title
  "permalink" .RelPermalink
  "date" (.Date.Format "2006-01-02")
  "dateLabel" (.Date.Format "Jan 2")
  "year" (.Date.Format "2006")
  "minutes" .ReadingTime
  "summary" (.Description | default (.Summary | plainify | htmlUnescape) | truncate 200)
  "content" (.Plain | htmlUnescape | truncate 5000)
  "tags" (.Params.tags | default slice)
) -}}
{{- end -}}
{{- $index | jsonify -}}
